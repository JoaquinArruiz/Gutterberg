{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Card Editor",
  "version": "0.1.0",
  "identifier": "dev.joaquinarruiz.pdf-card-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "PDF Card Editor", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": ["resources/pdfium/*"]
  }
}
