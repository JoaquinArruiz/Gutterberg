{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gutterberg",
  "version": "../package.json",
  "identifier": "dev.joaquinarruiz.gutterberg",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Gutterberg", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; media-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/pdfium/*"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["gtr"],
        "name": "Gutterberg project",
        "description": "Gutterberg project",
        "role": "Editor",
        "mimeType": "application/vnd.gutterberg.project+json",
        "exportedType": { "identifier": "dev.joaquinarruiz.gutterberg.project", "conformsTo": ["public.json"] }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMjI5RTM0QTk4RkI3MkYKUldRdnQ0K3BOSjRpb3hwWjRKT1BlNURvMTZJelUrS1kydFN6M1R5UnR3ZHAwRXkvZ0pIc1NaZjEK",
      "endpoints": ["https://github.com/JoaquinArruiz/Gutterberg/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
